{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "VITE_CORE_API_BASE_URL=/api npm run build:live-sticker",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/task-map",
      "destination": "/live-sticker/"
    },
    {
      "source": "/task-map/:path*",
      "destination": "/live-sticker/"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/live-sticker/",
      "permanent": false
    },
    {
      "source": "/live-sticker",
      "destination": "/live-sticker/",
      "permanent": true
    }
  ]
}
